{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			// Tasks don't inherit the Nix dev environment, so take node and pnpm from shell.nix.
			"command": "nix-shell",
			"args": ["--run", "pnpm run build"],
			"problemMatcher": "$esbuild",
			"group": { "kind": "build", "isDefault": true }
		}
	]
}

{
  "name": "vs-odoo-inspector",
  "displayName": "VS Odoo Inspector",
  "description": "Query Odoo databases from chat, approving every column before it reaches the model.",
  "version": "0.2.0",
  "publisher": "odoo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "odooInspector.mcp",
        "label": "Odoo Inspector"
      }
    ],
    "commands": [
      {
        "command": "odooInspector.addConnection",
        "title": "Add Connection",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.setCredentials",
        "title": "Set Credentials",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.connect",
        "title": "Connect",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.disconnect",
        "title": "Disconnect",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.resetApprovals",
        "title": "Reset Column Approvals",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.manageApprovals",
        "title": "Manage Column Approvals",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.showOutput",
        "title": "Show Output",
        "category": "Odoo"
      }
    ],
    "configuration": {
      "title": "Odoo Inspector",
      "properties": {
        "odooInspector.connections": {
          "type": "array",
          "default": [],
          "markdownDescription": "Odoo databases the tools can use. Add one with **Odoo: Add Connection**. Credentials are kept in the OS keychain, never here.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url",
              "db",
              "login"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique label, used as the tools' `connection` argument."
              },
              "url": {
                "type": "string",
                "description": "Base URL, e.g. https://mycompany.odoo.com or http://localhost:8069."
              },
              "db": {
                "type": "string",
                "description": "Database name."
              },
              "login": {
                "type": "string",
                "description": "Login of the user the credential belongs to."
              },
              "authMethod": {
                "type": "string",
                "enum": [
                  "auto",
                  "apiKey",
                  "password",
                  "session"
                ],
                "default": "auto",
                "markdownDescription": "Credential kind. `auto` guesses from its shape (40 hex characters: API key; 42+ url-safe characters: session id; otherwise password)."
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "auto",
                  "jsonrpc",
                  "xmlrpc",
                  "callKw",
                  "json2"
                ],
                "default": "auto",
                "markdownDescription": "RPC protocol. `auto`: `json2` for API keys on Odoo 18.5+, `callKw` for session tokens, `jsonrpc` otherwise. API keys cannot use `callKw`; session tokens can only use `callKw`; `json2` only takes API keys."
              }
            }
          }
        },
        "odooInspector.activeConnection": {
          "type": "string",
          "default": "",
          "description": "Connection used when a tool call names none."
        },
        "odooInspector.rateLimitPerSecond": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Maximum Odoo requests per second (0 = unlimited). Odoo SaaS throttles aggressively."
        },
        "odooInspector.maxRows": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Maximum rows a read returns."
        },
        "odooInspector.approval.previewRows": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Rows shown in the in-chat approval table."
        },
        "odooInspector.approval.autoApproveKnownColumns": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Skip the approval when every column of a read was already approved in this chat session (withheld columns are still removed). Writes are always reviewed."
        },
        "odooInspector.enableExecuteKw": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Expose `odoo_execute_kw`, which can call any method, including ones that change data. Every non-read call is reviewed before it is sent. Restart the MCP server after changing this."
        }
      }
    }
  },
  "scripts": {
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vscode:prepublish": "pnpm run package",
    "check-types": "tsc --noEmit",
    "test": "mocha --ui tdd --import=tsx \"src/test/*.test.ts\"",
    "e2e": "node scripts/run-e2e.js",
    "check:view": "node scripts/run-view-check.js",
    "test:integration": "mocha --ui tdd --import=tsx src/test/integration/*.test.ts",
    "build": "node esbuild.js",
    "lint": "eslint",
    "vsix": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "fast-xml-parser": "5.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.109.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "mocha": "12.0.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}

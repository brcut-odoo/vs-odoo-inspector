{
  "name": "vs-odoo-inspector",
  "displayName": "VS Odoo Inspector",
  "description": "Query Odoo databases from chat, approving every column before it reaches the model.",
  "version": "0.2.0",
  "publisher": "odoo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "odooInspector.mcp",
        "label": "Odoo Inspector"
      }
    ],
    "commands": [
      {
        "command": "odooInspector.disconnect",
        "title": "Disconnect",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.forgetConnectionHistory",
        "title": "Forget Connection History",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.resetApprovals",
        "title": "Reset Column Approvals",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.manageApprovals",
        "title": "Manage Column Approvals",
        "category": "Odoo"
      },
      {
        "command": "odooInspector.showOutput",
        "title": "Show Output",
        "category": "Odoo"
      }
    ],
    "configuration": {
      "title": "Odoo Inspector",
      "properties": {
        "odooInspector.rateLimitPerSecond": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Maximum Odoo requests per second (0 = unlimited). Odoo SaaS throttles aggressively."
        },
        "odooInspector.maxRows": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Maximum rows a read returns."
        },
        "odooInspector.approval.previewRows": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Rows shown in the in-chat approval table."
        },
        "odooInspector.approval.autoApproveKnownColumns": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Skip the approval when every column of a read was already approved in this chat session (withheld columns are still removed). Writes are always reviewed."
        },
        "odooInspector.enableExecuteKw": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Expose `odoo_execute_kw`, which can call any method, including ones that change data. Every non-read call is reviewed before it is sent. Restart the MCP server after changing this."
        }
      }
    }
  },
  "scripts": {
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vscode:prepublish": "pnpm run package",
    "check-types": "tsc --noEmit",
    "test": "mocha --ui tdd --import=tsx \"src/test/*.test.ts\"",
    "e2e": "node scripts/run-e2e.js",
    "check:view": "node scripts/run-view-check.js",
    "test:integration": "mocha --ui tdd --import=tsx src/test/integration/*.test.ts",
    "build": "node esbuild.js",
    "lint": "eslint",
    "vsix": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "fast-xml-parser": "5.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.109.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "mocha": "12.0.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
